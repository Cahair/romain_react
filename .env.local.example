# Copier ce fichier en .env.local (en local) et reporter les mêmes variables chez l'hébergeur.

# --- Envoi des demandes (/demarrer → contact@romain-kantzer.com) ---
# Option 1 (recommandée) : SMTP Infomaniak de la boîte contact@romain-kantzer.com.
# SMTP_PASS = mot de passe de l'adresse e-mail (pas celui du compte Infomaniak),
# ou un mot de passe d'application créé dans Infomaniak Mail si la double authentification est active.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=contact@romain-kantzer.com
SMTP_PASS=
# SMTP_FROM=contact@romain-kantzer.com   # expéditeur, par défaut SMTP_USER
# SMTP_SECURE=true                       # par défaut : true si le port est 465

# Option 2 (secours, essayée si le SMTP échoue) : Resend, avec un domaine vérifié.
# RESEND_API_KEY=
# RESEND_FROM=site@romain-kantzer.com

# Ancien réglage Gmail (utilisé seulement si SMTP_* est vide) : adresse + mot de passe d'application.
# EMAIL_USER=
# EMAIL_PASS=

# Mettre « mailto » pour revenir à l'ouverture de la messagerie du visiteur (rebuild nécessaire).
# NEXT_PUBLIC_CONTACT_MODE=mailto

# --- Assistant ---
GEMINI_API_KEY=

# --- Mesure d'audience (Umami) ---
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# --- Espace admin ---
# SITE_URL=https://romain-kantzer.com
# ADMIN_SESSION_SECRET=
# ADMIN_DATA_DIR=
# AUTOMATION_WEBHOOK_URL=
# AUTOMATION_WEBHOOK_SECRET=
